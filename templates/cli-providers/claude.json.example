{
  "binary": "claude",
  "default_args": "-p --dangerously-skip-permissions",
  "agent_flag": null,
  "model_flag": "--model",
  "agent_model": "sonnet",
  "effort_flag": null,
  "prompt_mode": "stdin",
  "resume_flag": "-r",
  "session_dir": "~/.claude/projects",
  "models": {
    "opus": "opus",
    "sonnet": "sonnet",
    "haiku": "haiku",
    "fable": "fable",
    "auto": "sonnet"
  }
}
