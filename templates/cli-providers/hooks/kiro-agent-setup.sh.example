#!/usr/bin/env bash
# Kiro CLI agent setup hook for brainiac
#
# Called by `brainiac agent create` and `brainiac agent setup` after writing
# the brainiac-side files. Creates ~/.kiro/agents/<key>.json with sensible defaults.
#
# Input (stdin): JSON with "agent_key" and "entry" (the agents.json entry)
# Output (stdout): status messages
# Exit code: 0 = success, non-zero = failure
#
# Install: copy to ~/.brainiac/cli-providers/hooks/kiro-agent-setup.sh
#          and chmod +x

set -euo pipefail

KIRO_AGENTS_DIR="${HOME}/.kiro/agents"
mkdir -p "$KIRO_AGENTS_DIR"

# Read JSON from stdin
INPUT=$(cat)
AGENT_KEY=$(echo "$INPUT" | jq -r '.agent_key')
DISPLAY_NAME=$(echo "$INPUT" | jq -r '.entry.display_name // empty')
ROLE=$(echo "$INPUT" | jq -r '.entry.role | if type == "array" then .[0] else . end // empty')

if [[ -z "$AGENT_KEY" ]]; then
  echo "  [kiro] Error: agent_key not provided" >&2
  exit 1
fi

AGENT_FILE="${KIRO_AGENTS_DIR}/${AGENT_KEY}.json"

# Skip if already exists — let kiro-cli agent upgrade handle migration
if [[ -f "$AGENT_FILE" ]]; then
  echo "  [kiro] ${AGENT_FILE} already exists (skipping)"
  exit 0
fi

# Build a minimal Kiro agent config
# The v3 format uses "tools": ["*"] for unrestricted tool access
# and "resources" to load steering files

# Optional: load the role as a steering file if it exists
ROLE_RESOURCE=""
if [[ -n "$ROLE" ]] && [[ -f "${HOME}/.brainiac/roles/${ROLE}.md" ]]; then
  ROLE_RESOURCE="\"file://${HOME}/.brainiac/roles/${ROLE}.md\""
fi

# Create the agent file
# Use AGENT_KEY (lowercase) for name — Kiro-cli 3.x is case-sensitive
# and brainiac passes lowercase to --agent
if [[ -n "$ROLE_RESOURCE" ]]; then
  cat > "$AGENT_FILE" <<EOF
{
  "name": "${AGENT_KEY}",
  "tools": ["*"],
  "resources": [
    ${ROLE_RESOURCE}
  ]
}
EOF
else
  cat > "$AGENT_FILE" <<EOF
{
  "name": "${AGENT_KEY}",
  "tools": ["*"]
}
EOF
fi

echo "  [kiro] Created ${AGENT_FILE}"
