{
  "binary": "kiro-cli",
  "default_args": "chat --trust-all-tools --no-interactive",
  "readonly_args": "chat --no-interactive --trust-tools=fs_read",
  "agent_flag": "--agent",
  "model_flag": "--model",
  "effort_flag": "--effort",
  "prompt_mode": "stdin",
  "resume_id_flag": "--resume-id",
  "session_list_command": "kiro-cli chat --list-sessions -f json",
  "session_id_field": "sessionId",
  "session_directory_field": "cwd",
  "session_updated_field": "updatedAt",
  "list_models_command": "kiro-cli chat --list-models --format json",
  "models": {
    "opus": "claude-opus-4.5",
    "sonnet": "claude-sonnet-4.6",
    "haiku": "claude-haiku-4.5",
    "deepseek": "deepseek-3.2",
    "minimax": "minimax-m2.5",
    "minimax25": "minimax-m2.5",
    "minimax21": "minimax-m2.1",
    "qwen": "qwen3-coder-next",
    "auto": "auto"
  },
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "heaviness_probe": {
    "comment": "Optional. Lets brainiac record how 'heavy' a finished session was (context window usage + credits) in the durable session history. type selects the probe strategy; db_path points at the provider's local usage store. Omit this block to record timing/identity only.",
    "type": "kiro_sqlite",
    "db_path": "~/.local/share/kiro-cli/data.sqlite3"
  },
  "subagents": {
    "comment": "Optional. Renders the Subagents section of the agent prompt. tool is the CLI's subagent tool; usage lines are appended as how-to bullets; models (job => tier) tells the agent which cheaper model to hand each job. Omit the block for CLIs with no subagent tool.",
    "tool": "use_subagent",
    "usage": [
      "Use `relevant_context` to pass information the subagent needs.",
      "Set `agent_name` for a specialized agent (e.g. \"robin\" for Android research); run `ListAgents` to see them.",
      "Up to 4 subagents can run in parallel."
    ]
  }
}
