<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brainiac Analytics</title>
<style>
  :root { --bg: #0d1117; --card: #161b22; --border: #30363d; --text: #e6edf3; --dim: #8b949e; --green: #3fb950; --yellow: #d29922; --red: #f85149; --blue: #58a6ff; --purple: #bc8cff; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .header { padding: 16px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .header h1 { font-size: 18px; font-weight: 600; }
  .header .meta { font-size: 13px; color: var(--dim); }
  .header .controls { display: flex; gap: 8px; align-items: center; }
  .header select, .header input { background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 5px 10px; border-radius: 6px; font-size: 13px; }
  .container { max-width: 1200px; margin: 0 auto; padding: 24px; }
  .section-title { font-size: 14px; font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: 0.5px; margin: 28px 0 12px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
  .kpi .label { font-size: 12px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.5px; }
  .kpi .value { font-size: 26px; font-weight: 600; margin-top: 6px; font-variant-numeric: tabular-nums; }
  .kpi .sub { font-size: 12px; color: var(--dim); margin-top: 4px; }
  .kpi .value.good { color: var(--green); } .kpi .value.warn { color: var(--yellow); } .kpi .value.bad { color: var(--red); }
  .panel { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; overflow-x: auto; }
  .chart-legend { display: flex; gap: 16px; font-size: 12px; color: var(--dim); margin-bottom: 8px; flex-wrap: wrap; }
  .chart-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .swatch { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); color: var(--dim); font-weight: 500; white-space: nowrap; }
  td { padding: 8px 12px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
  tr:last-child td { border-bottom: none; }
  .bar { display: inline-block; height: 8px; border-radius: 2px; background: var(--blue); vertical-align: middle; }
  .rate.good { color: var(--green); } .rate.warn { color: var(--yellow); } .rate.bad { color: var(--red); }
  .rec { border-left: 3px solid var(--purple); background: rgba(188,140,255,0.06); border-radius: 6px; padding: 10px 14px; margin-bottom: 8px; font-size: 13px; }
  .rec .target { display: inline-block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 8px; border-radius: 10px; margin-right: 8px; background: rgba(188,140,255,0.15); color: var(--purple); }
  .anomaly-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; cursor: pointer; }
  .anomaly-row:last-child { border-bottom: none; }
  .anomaly-row:hover { background: rgba(88,166,255,0.06); }
  .sev { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .sev.high { background: var(--red); } .sev.medium { background: var(--yellow); } .sev.low { background: var(--dim); }
  .anomaly-row .kind { font-weight: 600; min-width: 120px; }
  .anomaly-row .msg { color: var(--dim); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .anomaly-row .drill { color: var(--blue); font-size: 12px; flex-shrink: 0; }
  .empty { text-align: center; padding: 32px; color: var(--dim); }
  /* log drill-down modal */
  .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; padding: 24px; z-index: 50; }
  .modal.open { display: flex; }
  .modal-box { background: var(--card); border: 1px solid var(--border); border-radius: 8px; width: 100%; max-width: 1000px; max-height: 85vh; display: flex; flex-direction: column; }
  .modal-head { padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .modal-head .title { font-size: 13px; font-weight: 600; word-break: break-all; }
  .modal-head button { background: var(--border); border: none; color: var(--text); padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
  .modal-head button:hover { background: var(--dim); }
  .modal-body { padding: 16px; overflow-y: auto; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; line-height: 1.6; white-space: pre-wrap; word-break: break-all; color: var(--dim); }
  .err-line { color: var(--red); }
  svg text { fill: var(--dim); font-size: 10px; }
  .loading { color: var(--dim); font-size: 13px; }
</style>
</head>
<body>
  <div class="header">
    <div>
      <h1>📊 Brainiac Analytics</h1>
      <div class="meta" id="meta">Loading…</div>
    </div>
    <div class="controls">
      <label class="meta">Period
        <select id="period">
          <option value="day">Day</option>
          <option value="week" selected>Week</option>
          <option value="month">Month</option>
        </select>
      </label>
      <label class="meta">Since <input type="date" id="since"></label>
      <a class="meta" id="dashlink" href="/dashboard">← Dashboard</a>
    </div>
  </div>

  <div class="container">
    <div class="kpis" id="kpis"><div class="loading">Loading KPIs…</div></div>

    <div class="section-title">Trend over time</div>
    <div class="panel">
      <div class="chart-legend">
        <span><span class="swatch" style="background:var(--red)"></span>Crash rate</span>
        <span><span class="swatch" style="background:var(--yellow)"></span>Error rate</span>
        <span><span class="swatch" style="background:var(--blue)"></span>Sessions (volume)</span>
      </div>
      <div id="trendChart" class="loading">Loading trend…</div>
    </div>

    <div class="section-title">Calibration recommendations</div>
    <div id="recs"><div class="loading">Loading…</div></div>

    <div class="section-title">By agent</div>
    <div class="panel"><table id="byAgent"><tbody><tr><td class="loading">Loading…</td></tr></tbody></table></div>

    <div class="section-title">By model</div>
    <div class="panel"><table id="byModel"><tbody><tr><td class="loading">Loading…</td></tr></tbody></table></div>

    <div class="section-title">Anomalies <span class="meta" id="anomalyCount"></span></div>
    <div class="panel" id="anomalies"><div class="loading">Loading…</div></div>
  </div>

  <div class="modal" id="modal">
    <div class="modal-box">
      <div class="modal-head">
        <span class="title" id="modalTitle">Log</span>
        <button onclick="closeModal()">Close ✕</button>
      </div>
      <div class="modal-body" id="modalBody">Loading…</div>
    </div>
  </div>

<script>
  const TOKEN = new URLSearchParams(window.location.search).get('token');
  function apiUrl(path) { return TOKEN ? path + (path.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(TOKEN) : path; }
  if (TOKEN) { document.getElementById('dashlink').href = '/dashboard?token=' + encodeURIComponent(TOKEN); }

  const fmtPct = (r) => (r == null ? '–' : (r * 100).toFixed(1) + '%');
  const rateClass = (r, warn, bad) => r == null ? '' : (r >= bad ? 'bad' : (r >= warn ? 'warn' : 'good'));
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  async function loadAll() {
    const period = document.getElementById('period').value;
    const since = document.getElementById('since').value;
    let perfPath = '/api/forensics/performance?period=' + period;
    if (since) perfPath += '&since=' + since;
    try {
      const [perf, fx] = await Promise.all([
        fetch(apiUrl(perfPath)).then(r => r.json()),
        fetch(apiUrl('/api/forensics?limit=100')).then(r => r.json())
      ]);
      renderKpis(perf.overall);
      renderTrend(perf.trends || []);
      renderRecs(perf.recommendations || []);
      renderBreakdown('byAgent', perf.by_agent || []);
      renderBreakdown('byModel', perf.by_model || []);
      renderAnomalies(fx.anomalies || []);
      document.getElementById('meta').textContent =
        'Generated ' + (perf.generated_at || '') + ' · ' + (perf.overall ? perf.overall.sessions : 0) + ' sessions';
    } catch (e) {
      document.getElementById('meta').textContent = 'Error loading analytics: ' + e;
    }
  }

  function renderKpis(o) {
    o = o || {};
    const card = (label, value, cls, sub) =>
      `<div class="kpi"><div class="label">${label}</div><div class="value ${cls||''}">${value}</div>${sub ? `<div class="sub">${sub}</div>` : ''}</div>`;
    document.getElementById('kpis').innerHTML = [
      card('Sessions', o.sessions ?? 0, '', (o.finished ?? 0) + ' finished'),
      card('Crash rate', fmtPct(o.crash_rate), rateClass(o.crash_rate, 0.05, 0.15)),
      card('Error rate', fmtPct(o.error_rate), rateClass(o.error_rate, 0.15, 0.30)),
      card('Avg duration', (o.avg_duration_seconds ?? '–') + (o.avg_duration_seconds != null ? 's' : ''), '', 'p95 ' + (o.p95_duration_seconds ?? '–') + 's'),
      card('Avg context', (o.avg_context_pct != null ? o.avg_context_pct + '%' : '–'), rateClass(o.avg_context_pct/100, 0.6, 0.8), 'max ' + (o.max_context_pct ?? '–') + '%'),
      card('Credits', o.total_credits ?? 0, '', 'avg ' + (o.avg_credits ?? '–'))
    ].join('');
  }

  // Inline SVG line+bar chart — no external libraries, matches the no-dep ethos.
  function renderTrend(trends) {
    const el = document.getElementById('trendChart');
    if (!trends.length) { el.className = 'empty'; el.textContent = 'No trend data yet.'; return; }
    el.className = '';
    const W = Math.max(640, trends.length * 60), H = 220, pad = 30;
    const maxN = Math.max(1, ...trends.map(t => t.metrics.sessions));
    const x = (i) => pad + i * ((W - pad * 2) / Math.max(1, trends.length - 1));
    const yRate = (r) => (H - pad) - (r || 0) * (H - pad * 2);
    const yVol = (n) => (H - pad) - (n / maxN) * (H - pad * 2);
    const bw = Math.max(4, (W - pad * 2) / trends.length * 0.5);

    const bars = trends.map((t, i) => {
      const h = (H - pad) - yVol(t.metrics.sessions);
      return `<rect x="${x(i) - bw / 2}" y="${yVol(t.metrics.sessions)}" width="${bw}" height="${Math.max(0, h)}" fill="rgba(88,166,255,0.25)" rx="2"/>`;
    }).join('');
    const line = (key, color) => {
      const pts = trends.map((t, i) => `${x(i)},${yRate(t.metrics[key])}`).join(' ');
      const dots = trends.map((t, i) => `<circle cx="${x(i)}" cy="${yRate(t.metrics[key])}" r="2.5" fill="${color}"/>`).join('');
      return `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.5"/>${dots}`;
    };
    const labels = trends.map((t, i) =>
      `<text x="${x(i)}" y="${H - 10}" text-anchor="middle">${esc(t.bucket).slice(-6)}</text>`).join('');
    const grid = [0, 0.25, 0.5, 0.75, 1].map(r =>
      `<line x1="${pad}" y1="${yRate(r)}" x2="${W - pad}" y2="${yRate(r)}" stroke="#30363d" stroke-width="0.5"/>` +
      `<text x="2" y="${yRate(r) + 3}">${(r * 100).toFixed(0)}%</text>`).join('');
    el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" preserveAspectRatio="xMidYMid meet">
      ${grid}${bars}${line('error_rate', '#d29922')}${line('crash_rate', '#f85149')}${labels}</svg>`;
  }

  function renderRecs(recs) {
    const el = document.getElementById('recs');
    if (!recs.length) { el.innerHTML = '<div class="empty">No calibration recommendations — things look healthy. ✨</div>'; return; }
    el.innerHTML = recs.map(r =>
      `<div class="rec"><span class="target">${esc(r.target)}</span>${esc(r.message)}</div>`).join('');
  }

  function renderBreakdown(id, rows) {
    const body = rows.length ? rows.map(b => {
      const m = b.metrics, maxBar = 120, n = m.sessions;
      return `<tr>
        <td>${esc(b.key)}</td>
        <td>${n} <span class="bar" style="width:${Math.min(maxBar, n)}px"></span></td>
        <td class="rate ${rateClass(m.crash_rate, 0.05, 0.15)}">${fmtPct(m.crash_rate)}</td>
        <td class="rate ${rateClass(m.error_rate, 0.15, 0.30)}">${fmtPct(m.error_rate)}</td>
        <td>${m.avg_duration_seconds ?? '–'}s</td>
        <td>${m.avg_context_pct != null ? m.avg_context_pct + '%' : '–'}</td>
        <td>${m.total_credits ?? '–'}</td>
      </tr>`;
    }).join('') : '<tr><td class="empty">No data</td></tr>';
    document.getElementById(id).innerHTML =
      `<thead><tr><th>Name</th><th>Sessions</th><th>Crash</th><th>Error</th><th>Avg dur</th><th>Avg ctx</th><th>Credits</th></tr></thead><tbody>${body}</tbody>`;
  }

  function renderAnomalies(anomalies) {
    document.getElementById('anomalyCount').textContent = anomalies.length ? '(' + anomalies.length + ')' : '';
    const el = document.getElementById('anomalies');
    if (!anomalies.length) { el.innerHTML = '<div class="empty">No anomalies detected. ✨</div>'; return; }
    const order = { high: 0, medium: 1, low: 2 };
    const sorted = anomalies.slice().sort((a, b) => (order[a.severity] ?? 9) - (order[b.severity] ?? 9));
    el.innerHTML = sorted.map(a => {
      const card = a.card_key ? ' [' + esc(a.card_key) + ']' : '';
      const drill = a.log_file ? `<span class="drill">view log →</span>` : '';
      return `<div class="anomaly-row" data-log="${esc(a.log_file || '')}">
        <span class="sev ${esc(a.severity)}"></span>
        <span class="kind">${esc(a.kind)}${card}</span>
        <span class="msg">${esc(a.agent || '')}: ${esc(a.message)}</span>${drill}</div>`;
    }).join('');
    el.querySelectorAll('.anomaly-row').forEach(row => {
      const f = row.getAttribute('data-log');
      if (f) row.addEventListener('click', () => openLog(f));
    });
  }

  async function openLog(file) {
    const modal = document.getElementById('modal');
    document.getElementById('modalTitle').textContent = file;
    document.getElementById('modalBody').textContent = 'Loading…';
    modal.classList.add('open');
    try {
      const r = await fetch(apiUrl('/api/logs?file=' + encodeURIComponent(file) + '&lines=400'));
      if (!r.ok) { document.getElementById('modalBody').textContent = 'Error ' + r.status + ': ' + (await r.text()); return; }
      const text = await r.text();
      const errRe = /(error|exception|panic|fatal|traceback|not found)/i;
      document.getElementById('modalBody').innerHTML = text.split('\n')
        .map(l => errRe.test(l) ? `<span class="err-line">${esc(l)}</span>` : esc(l)).join('\n');
    } catch (e) {
      document.getElementById('modalBody').textContent = 'Error: ' + e;
    }
  }
  function closeModal() { document.getElementById('modal').classList.remove('open'); }
  document.getElementById('modal').addEventListener('click', (e) => { if (e.target.id === 'modal') closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  document.getElementById('period').addEventListener('change', loadAll);
  document.getElementById('since').addEventListener('change', loadAll);

  loadAll();
</script>
</body>
</html>
